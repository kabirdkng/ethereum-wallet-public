{
  "name": "ethereum-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:ngrok": "concurrently --names \"NEXT,NGROK\" --prefix-colors \"blue,magenta\" \"next dev\" \"ngrok http 3000 --log=stdout\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@noble/hashes": "^1.3.3",
    "@prisma/client": "^6.18.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.63.0",
    "ioredis": "^5.8.2",
    "jsqr": "^1.4.0",
    "next": "^16.0.8",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "resend": "^6.4.0",
    "secrets.js-grempe": "^2.0.0",
    "twilio": "^5.10.4",
    "viem": "^2.38.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
